# Copia este archivo a .env y ajusta los valores si es necesario.
DATABASE_URL="postgresql://datagsports:datagsports_dev@localhost:5432/datagsports_2026?schema=public"

# Momios actuales de varias casas (https://the-odds-api.com, plan gratis: 500 créditos/mes).
ODDS_API_KEY=""
# Regiones de casas (us, us2, uk, eu, au): cada región multiplica el costo. O fija casas con ODDS_API_BOOKMAKERS.
ODDS_API_REGIONS="us"
